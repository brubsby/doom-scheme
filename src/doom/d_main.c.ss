;;; d_main.c: startup, the main loop, the display, and the title / demo
;;; sequence. Included by d_main.sls.

(define MAXWADFILES 20)
(define wadfiles '())                   ; in order


;; EVENT HANDLING
;; Events are asynchronous inputs generally generated by the game user.
;; Events can be discarded if no responder claims them.
(define events
  (let ([v (make-vector MAXEVENTS)])
    (do ([i 0 (fx+ i 1)]) ((fx= i MAXEVENTS) v)
      (vector-set! v i (make-event)))))
(define eventhead 0)
(define eventtail 0)

;; D_PostEvent: called by the I/O functions when input is detected.
(define (d-post-event ev)
  (struct-copy! (vector-ref events eventhead) ev)
  (set! eventhead (fxand (fx+ eventhead 1) (fx- MAXEVENTS 1))))

;; D_ProcessEvents: send all the events of the given timestamp down the
;; responder chain.
(define (d-process-events)
  ;; IF STORE DEMO, DO NOT ACCEPT INPUT
  (unless (and (fx= gamemode commercial) (fx< (w-check-num-for-name "map01") 0))
    (let loop ()
      (unless (fx= eventtail eventhead)
        (let ([ev (vector-ref events eventtail)])
          (unless (m-responder ev)      ; menu ate the event
            (g-responder ev)))
        (set! eventtail (fxand (fx+ eventtail 1) (fx- MAXEVENTS 1)))
        (loop)))))

;; D_Display: draw current display, possibly wiping it from the previous.
;; wipegamestate can be set to -1 to force a wipe on the next draw.
;; TODO(milestone 7): the wipe (f_wipe) itself.
(define viewactivestate #f)
(define menuactivestate #f)
(define inhelpscreensstate #f)
(define fullscreen #f)
(define oldgamestate -1)
(define borderdrawcount 0)

(define (d-display)
  (unless nodrawers                     ; for comparative timing / profiling
    (let ([redrawsbar #f]
          [wipe #f])
      ;; change the view size if needed
      (when setsizeneeded
        (r-execute-set-view-size)
        (set! oldgamestate -1)          ; force background redraw
        (set! borderdrawcount 3))
      ;; save the current screen if about to wipe
      (unless (fx= gamestate wipegamestate)
        (set! wipe #t))
      (when (and (fx= gamestate GS_LEVEL) (not (fx= gametic 0)))
        (hu-erase))
      ;; do buffered drawing
      (cond
        [(fx= gamestate GS_LEVEL)
         (unless (fx= gametic 0)
           (when automapactive
             (am-drawer))
           (when (or wipe (and (not (fx= viewheight 200)) fullscreen))
             (set! redrawsbar #t))
           (when (and inhelpscreensstate (not inhelpscreens))
             (set! redrawsbar #t))      ; just put away the help screen
           (st-drawer (fx= viewheight 200) redrawsbar)
           (set! fullscreen (fx= viewheight 200)))]
        [(fx= gamestate GS_INTERMISSION) (wi-drawer)]
        [(fx= gamestate GS_FINALE) (f-drawer)]
        [(fx= gamestate GS_DEMOSCREEN) (d-page-drawer)])
      ;; draw buffered stuff to screen
      (i-update-no-blit)
      ;; draw the view directly
      (when (and (fx= gamestate GS_LEVEL) (not automapactive) (not (fx= gametic 0)))
        (r-render-player-view (vector-ref players displayplayer)))
      (when (and (fx= gamestate GS_LEVEL) (not (fx= gametic 0)))
        (hu-drawer))
      ;; clean up border stuff
      (when (and (not (fx= gamestate oldgamestate)) (not (fx= gamestate GS_LEVEL)))
        (i-set-palette (w-cache-lump-name "PLAYPAL")))
      ;; see if the border needs to be initially drawn
      (when (and (fx= gamestate GS_LEVEL) (not (fx= oldgamestate GS_LEVEL)))
        (set! viewactivestate #f)       ; view was not active
        (r-fill-back-screen))           ; draw the pattern into the back screen
      ;; see if the border needs to be updated to the screen
      (when (and (fx= gamestate GS_LEVEL) (not automapactive) (not (fx= scaledviewwidth 320)))
        (when (or menuactive menuactivestate (not viewactivestate))
          (set! borderdrawcount 3))
        (unless (fx= borderdrawcount 0)
          (r-draw-view-border)          ; erase old menu stuff
          (set! borderdrawcount (fx- borderdrawcount 1))))
      (set! menuactivestate menuactive)
      (set! viewactivestate viewactive)
      (set! inhelpscreensstate inhelpscreens)
      (set! oldgamestate gamestate)
      (set! wipegamestate gamestate)
      ;; draw pause pic
      (when paused
        (v-draw-patch-direct (fx+ viewwindowx (fxquotient (fx- scaledviewwidth 68) 2))
                             (if automapactive 4 (fx+ viewwindowy 4))
                             0 (w-cache-lump-name "M_PAUSE")))
      ;; menus go directly to the screen
      (m-drawer)                        ; menu is drawn even on top of everything
      (net-update)                      ; send out any new accumulation
      ;; normal update (and, until f_wipe exists, the wipe too)
      (i-finish-update))))

;; D_DoomLoop
(define (d-doom-loop)
  (when demorecording
    (g-begin-recording))
  ;; (-debugfile is not supported)
  (unless nodrawers
    (i-init-graphics))
  (let loop ()
    ;; frame syncronous IO operations
    (i-start-frame)
    ;; process one or more tics
    (if singletics
        (begin
          (i-start-tic d-post-event)
          (d-process-events)
          (g-build-ticcmd (vector-ref (vector-ref netcmds consoleplayer)
                                      (fxremainder maketic BACKUPTICS)))
          (set! maketic (fx+ maketic 1))
          (run-one-tic))
        (try-run-tics))                 ; will run at least one tic
    (s-update-sounds (player-mo (vector-ref players consoleplayer))) ; move positional sounds
    ;; Update display, next frame, with current state.
    (d-display)
    (loop)))

;; DEMO LOOP
(define demosequence 0)
(define pagetic 0)
(define pagename "TITLEPIC")

;; D_PageTicker: handles timing for warped projection.
(define (d-page-ticker)
  (set! pagetic (fx- pagetic 1))
  (when (fx< pagetic 0)
    (d-advance-demo)))

;; D_PageDrawer
(define (d-page-drawer)
  (v-draw-patch 0 0 0 (w-cache-lump-name pagename)))

;; D_AdvanceDemo: called after each demo or intro demosequence finishes.
(define (d-advance-demo)
  (set! advancedemo #t))

;; This cycles through the demo sequences.
(define (d-do-advance-demo)
  (player-playerstate-set! (vector-ref players consoleplayer) PST_LIVE) ; not reborn
  (set! advancedemo #f)
  (set! usergame #f)                    ; no save / end game here
  (set! paused #f)
  (set! gameaction ga_nothing)
  (set! demosequence (fxremainder (fx+ demosequence 1) (if (fx= gamemode retail) 7 6)))
  (case demosequence
    [(0)
     (set! pagetic (if (fx= gamemode commercial) (* 35 11) 170))
     (set! gamestate GS_DEMOSCREEN)
     (set! pagename "TITLEPIC")
     (s-start-music (if (fx= gamemode commercial) mus_dm2ttl mus_intro))]
    [(1) (g-defered-play-demo "demo1")]
    [(2)
     (set! pagetic 200)
     (set! gamestate GS_DEMOSCREEN)
     (set! pagename "CREDIT")]
    [(3) (g-defered-play-demo "demo2")]
    [(4)
     (set! gamestate GS_DEMOSCREEN)
     (if (fx= gamemode commercial)
         (begin
           (set! pagetic (* 35 11))
           (set! pagename "TITLEPIC")
           (s-start-music mus_dm2ttl))
         (begin
           (set! pagetic 200)
           (set! pagename (if (fx= gamemode retail) "CREDIT" "HELP2"))))]
    [(5) (g-defered-play-demo "demo3")]
    ;; THE DEFINITIVE DOOM Special Edition demo
    [(6) (g-defered-play-demo "demo4")]))

;; D_StartTitle
(define (d-start-title)
  (set! gameaction ga_nothing)
  (set! demosequence -1)
  (d-advance-demo))

;; D_AddFile
(define (d-add-file file)
  (set! wadfiles (append wadfiles (list file))))

;; IdentifyVersion: checks availability of IWAD files by name, to determine
;; whether registered/commercial features should be executed (notably
;; loading PWAD's). Looks in $DOOMWADDIR, or else "." -- and, unlike C,
;; then "wads" (where make wad puts doom1.wad).
(define (identify-version)
  (let* ([doomwaddir (or (getenv "DOOMWADDIR")
                         (if (file-exists? "doom1.wad") "." "wads"))]
         [path (lambda (name) (string-append doomwaddir "/" name))]
         [have (lambda (name) (file-exists? (path name)))])
    ;; (-shdev, -regdev and -comdev are id's development setups; not
    ;; supported)
    (cond
      [(have "doom2f.wad")
       (set! gamemode commercial)
       ;; C'est ridicule! Let's handle languages in config files, okay?
       (set! language french)
       (d-add-file (path "doom2f.wad"))]
      [(have "doom2.wad") (set! gamemode commercial) (d-add-file (path "doom2.wad"))]
      [(have "plutonia.wad") (set! gamemode commercial) (d-add-file (path "plutonia.wad"))]
      [(have "tnt.wad") (set! gamemode commercial) (d-add-file (path "tnt.wad"))]
      [(have "doomu.wad") (set! gamemode retail) (d-add-file (path "doomu.wad"))]
      [(have "doom.wad") (set! gamemode registered) (d-add-file (path "doom.wad"))]
      [(have "doom1.wad") (set! gamemode shareware) (d-add-file (path "doom1.wad"))]
      ;; We don't abort. Let's see what the PWAD contains.
      [else (set! gamemode indetermined)])))

(define (arg n) (vector-ref myargv n))
;; The argument after -parm, or #f.
(define (parm-arg parm)
  (let ([p (m-check-parm parm)])
    (and (fx> p 0) (fx< p (fx- myargc 1)) (arg (fx+ p 1)))))
(define (digit c) (fx- (char->integer c) (char->integer #\0)))

;; D_DoomMain. (-turbo, -wart, -file, -record, -playdemo, -timedemo,
;; -skill, -episode, -warp, -nomonsters, -respawn, -fast, -deathmatch,
;; -altdeath and -devparm work; -loadgame waits for p_saveg.)
(define (d-doom-main)
  ;; (FindResponseFile: @responsefile is not supported)
  (identify-version)
  (set! modifiedgame #f)
  (set! nomonsters (fx> (m-check-parm "-nomonsters") 0))
  (set! respawnparm (fx> (m-check-parm "-respawn") 0))
  (set! fastparm (fx> (m-check-parm "-fast") 0))
  (set! devparm (fx> (m-check-parm "-devparm") 0))
  (cond [(fx> (m-check-parm "-altdeath") 0) (set! deathmatch 2)]
        [(fx> (m-check-parm "-deathmatch") 0) (set! deathmatch 1)])
  (printf "~a\n"
          (case gamemode
            [(3) "The Ultimate DOOM Startup v1.10"]   ; retail
            [(0) "DOOM Shareware Startup v1.10"]      ; shareware
            [(1) "DOOM Registered Startup v1.10"]     ; registered
            [(2) "DOOM 2: Hell on Earth v1.10"]       ; commercial
            [else "Public DOOM - v1.10"]))
  (when devparm
    (display D_DEVSTR))
  ;; turbo option
  (let ([p (m-check-parm "-turbo")])
    (unless (fx= p 0)
      (let* ([scale (if (fx< p (fx- myargc 1)) (or (string->number (arg (fx+ p 1))) 0) 200)]
             [scale (fxmax 10 (fxmin 400 scale))])
        (printf "turbo scale: ~a%\n" scale)
        (fxvector-set! forwardmove 0 (fxquotient (fx* (fxvector-ref forwardmove 0) scale) 100))
        (fxvector-set! forwardmove 1 (fxquotient (fx* (fxvector-ref forwardmove 1) scale) 100))
        (fxvector-set! sidemove 0 (fxquotient (fx* (fxvector-ref sidemove 0) scale) 100))
        (fxvector-set! sidemove 1 (fxquotient (fx* (fxvector-ref sidemove 1) scale) 100)))))
  ;; add any files specified on the command line with -file wadfile to the
  ;; wad list
  (let ([p (m-check-parm "-file")])
    (unless (fx= p 0)
      ;; the parms after p are wadfile/lump names, until end of parms or
      ;; another - preceded parm
      (set! modifiedgame #t)            ; homebrew levels
      (let loop ([p (fx+ p 1)])
        (when (and (fx< p myargc) (not (char=? (string-ref (arg p) 0) #\-)))
          (d-add-file (arg p))
          (loop (fx+ p 1))))))
  (let ([demo (or (parm-arg "-playdemo") (parm-arg "-timedemo"))])
    (when demo
      (d-add-file (string-append demo ".lmp"))
      (printf "Playing demo ~a.lmp.\n" demo)))
  ;; get skill / episode / map from parms
  (set! startskill sk_medium)
  (set! startepisode 1)
  (set! startmap 1)
  (set! autostart #f)
  (let ([s (parm-arg "-skill")])
    (when s
      (set! startskill (fx- (char->integer (string-ref s 0)) (char->integer #\1)))
      (set! autostart #t)))
  (let ([e (parm-arg "-episode")])
    (when e
      (set! startepisode (digit (string-ref e 0)))
      (set! startmap 1)
      (set! autostart #t)))
  ;; (-timer and -avg are deathmatch options; p_spec doesn't support them)
  (let ([p (m-check-parm "-warp")])
    (when (and (fx> p 0) (fx< p (fx- myargc 1)))
      (if (fx= gamemode commercial)
          (set! startmap (or (string->number (arg (fx+ p 1))) 0))
          (begin
            (set! startepisode (digit (string-ref (arg (fx+ p 1)) 0)))
            (set! startmap (digit (string-ref (arg (fx+ p 2)) 0)))))
      (set! autostart #t)))
  ;; init subsystems
  (printf "V_Init: allocate screens.\n")
  (v-init)
  (printf "M_LoadDefaults: Load system defaults.\n")
  (m-load-defaults)                     ; load before initing other systems
  (printf "W_Init: Init WADfiles.\n")
  (w-init-multiple-files wadfiles)
  ;; Check for -file in shareware
  (when modifiedgame
    (when (fx= gamemode shareware)
      (i-error "\nYou cannot -file with the shareware version. Register!"))
    ;; Check for fake IWAD with right name, but w/o all the lumps of the
    ;; registered version.
    (when (fx= gamemode registered)
      (for-each (lambda (name)
                  (when (fx< (w-check-num-for-name name) 0)
                    (i-error "\nThis is not the registered version.")))
                '("e2m1" "e2m2" "e2m3" "e2m4" "e2m5" "e2m6" "e2m7" "e2m8" "e2m9"
                  "e3m1" "e3m3" "e3m3" "e3m4" "e3m5" "e3m6" "e3m7" "e3m8" "e3m9"
                  "dphoof" "bfgga0" "heada1" "cybra1" "spida1d1"))))
  (printf "M_Init: Init miscellaneous info.\n")
  (m-init)
  (printf "R_Init: Init DOOM refresh daemon - \n")
  (r-init screenblocks detailLevel)
  (printf "P_Init: Init Playloop state.\n")
  (p-init)
  (printf "D_CheckNetGame: Checking network game status.\n")
  (d-check-net-game)
  (printf "S_Init: Setting up sound.\n")
  (s-init snd_SfxVolume snd_MusicVolume)
  (printf "HU_Init: Setting up heads up display.\n")
  (hu-init)
  (printf "ST_Init: Init status bar.\n")
  (st-init)
  ;; start the apropriate game based on parms
  (let ([name (parm-arg "-record")])
    (when name
      (g-record-demo name)
      (set! autostart #t)))
  (let ([name (parm-arg "-playdemo")])
    (when name
      (set! singledemo #t)              ; quit after one demo
      (g-defered-play-demo name)
      (d-doom-loop)))                   ; never returns
  (let ([name (parm-arg "-timedemo")])
    (when name
      (g-time-demo name)
      (d-doom-loop)))                   ; never returns
  (let ([slot (parm-arg "-loadgame")])
    (when slot
      (g-load-game (format "doomsav~a.dsg" (string-ref slot 0)))))
  (unless (fx= gameaction ga_loadgame)
    (if (or autostart netgame)
        (g-init-new startskill startepisode startmap)
        (d-start-title)))               ; start up intro loop
  (d-doom-loop))                        ; never returns

;; Run D_DoomMain with the given command line (strings, without argv[0])
;; until the game quits; I_Quit returns 0, I_Error prints "Error: ..." and
;; returns 255 (saving a demo being recorded, as I_Error does).
(define (d-run args)
  (m-set-args! (cons "doom" args))
  (call/cc
   (lambda (k)
     (with-exception-handler
      (lambda (c)
        (k (cond
             [(doom-quit? c)
              (i-shutdown-graphics)
              0]
             [(doom-error? c)
              (when demorecording
                (guard (c2 [#t (void)])
                  (g-check-demo-status)))
              (i-shutdown-graphics)
              (display (string-append "Error: " (condition-message c) "\n") (current-error-port))
              255]
             [else (raise c)])))
      (lambda () (d-doom-main))))))
